{
  "name": "flashloop-blue",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint src",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:auth && npm run test:edge && npm run test:ownership && npm run test:entitlements && npm run test:storage && npm run test:jobs && npm run test:billing && npm run test:observability && npm run test:cache && npm run test:workspace && npm run audit:assets && npm run build",
    "test:workspace": "node --test tests/creation-draft.test.cjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "test:auth": "node --test tests/auth-security.test.mjs tests/auth-handlers.test.cjs tests/auth-client.test.cjs tests/administrative-fixture.test.mjs",
    "test:edge": "node --test tests/edge-origin.test.cjs tests/edge-handlers.test.cjs tests/provider-fetch.test.cjs",
    "test:edge:runtime": "node scripts/verify-edge-runtime.mjs",
    "test:edge:provider": "node scripts/verify-direct-auth.mjs",
    "test:signup:database": "node supabase/tests/run-signup-quota-regression.mjs",
    "test:auth:database": "npm test --prefix supabase/tests",
    "test:ownership": "node --test tests/ownership-handlers.test.cjs",
    "test:entitlements": "node --test tests/entitlements.test.cjs",
    "test:entitlements:database": "npm run test:generation --prefix supabase/tests",
    "test:ownership:database": "npm run test:ownership --prefix supabase/tests",
    "test:ownership:staging": "node scripts/verify-ownership-provider.mjs",
    "test:storage": "node --test tests/storage-*.test.cjs tests/provider-destinations.test.cjs",
    "test:storage:database": "npm run test:storage --prefix supabase/tests",
    "test:entitlements:concurrency": "npm run test:generation:concurrency --prefix supabase/tests",
    "test:storage:runtime": "node scripts/verify-storage-disabled.mjs",
    "test:storage:concurrency": "node supabase/tests/run-storage-concurrency.mjs",
    "test:jobs": "node --test tests/generation-*.test.cjs",
    "test:jobs:database": "npm run test:jobs --prefix supabase/tests",
    "test:jobs:concurrency": "npm run test:jobs:concurrency --prefix supabase/tests",
    "test:jobs:runtime": "node scripts/verify-jobs-disabled.mjs",
    "test:billing": "node --test tests/billing-*.test.cjs",
    "test:billing:database": "node supabase/tests/run-billing-regression.mjs",
    "test:billing:concurrency": "node supabase/tests/run-billing-concurrency.mjs",
    "test:observability": "node --test tests/observability-*.test.cjs tests/analytics.test.cjs",
    "test:cache": "node --test tests/http-caching.test.cjs",
    "test:cache:runtime": "node scripts/verify-http-caching.mjs",
    "test:sentry:staging": "node scripts/verify-sentry-staging.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1162.0",
    "@aws-sdk/s3-request-presigner": "3.1162.0",
    "@sentry/node": "11.11.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@whop/sdk": "2.7.0",
    "inngest": "4.26.2",
    "next": "16.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "typescript": "^5"
  }
}
